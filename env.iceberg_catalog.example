# Personal overrides for the Iceberg Catalog Migration DAG (iceberg_catalog_migration)
# Copy to env.migration_dag_iceberg_catalog, or pass via: deploy.py --env-file

MIGRATION_TRACKING_DATABASE=migration_tracking_<your_initials>
MIGRATION_TRACKING_LOCATION=s3a://your-bucket/migration_tracking_<your_initials>
MIGRATION_REPORT_LOCATION=s3a://your-bucket/migration_reports_<your_initials>
MIGRATION_EMAIL_RECIPIENTS=you@nexuscognitive.com
MIGRATION_SMTP_CONN_ID=smtp_default

# This DAG reads no other settings from get_config(): source and destination are
# per-row Excel columns (source_s3_prefix / dest_s3_prefix), and there is no
# DistCp or SSH stage. MIGRATION_RECREATE_TABLES (DAG 1) and
# MIGRATION_ICEBERG_DROP_BACKUP (DAG 2) have no effect here.

# Personal overrides for the Data Iceberg Migrator DAG
# Copy to env.<your_dag_filename> (without .py)

MIGRATION_TRACKING_DATABASE=migration_tracking_<your_initials>
MIGRATION_TRACKING_LOCATION=s3a://your-bucket/migration_tracking_<your_initials>
MIGRATION_REPORT_LOCATION=s3a://your-bucket/migration_reports_<your_initials>
MIGRATION_EMAIL_RECIPIENTS=you@nexuscognitive.com

# Drop & recreate existing destination Hive tables from scratch (metadata only —
# EXTERNAL tables keep their S3 data). Set to true to fix tables created by an
# older DAG version with wrongly-typed partition columns, then set back to false.
# Also settable via the Airflow Variable 'migration_recreate_tables'.
MIGRATION_RECREATE_TABLES=false

# How many tables one discovery pyspark driver walks concurrently (threadpool in
# the pyspark script, each thread issues DESCRIBE FORMATTED / SHOW PARTITIONS /
# SELECT COUNT(*) against the source metastore). Default 8 is safe across every
# supported edge (MapR Hive 1.2 through CDP Hive 3.1). Raise for faster
# discovery against a healthy metastore; lower if HMS is stressed.
# Clamped to [1, 64]. Also settable via Airflow Variable
# 'migration_discovery_per_table_parallelism'.
MIGRATION_DISCOVERY_PER_TABLE_PARALLELISM=8

# Concurrency caps on the per-run mapped tasks. Each discovery is a local[*]
# pyspark driver on the edge node (edge-OOM cap, not Airflow policy); each
# DistCp copy competes for the shared YARN queue. These are read at DAG parse
# time, so a change via Airflow Variable (preferred for day-of tuning) takes
# effect within one scheduler parse loop (~30s) without a redeploy. Precedence:
# Variable 'migration_discovery_max_concurrent' / 'migration_distcp_copy_max_concurrent'
# > env var > default (3). Non-positive or non-integer Variable values fall
# through to env.
MIGRATION_DISCOVERY_MAX_CONCURRENT=3
MIGRATION_DISTCP_COPY_MAX_CONCURRENT=3

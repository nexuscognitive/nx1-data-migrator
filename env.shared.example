# Shared environment configuration
# Copy to env.shared and fill in actual values.
# It provides configuration for both Data Iceberg Migrator DAG and Ranger Policies Generator DAG.
# Only one copy should be present in the DAG folder.

# ==== deploy.py — S3 deployment target ====
DEPLOY_S3_BUCKET=your-bucket-name
DEPLOY_DAGS_PREFIX=airflow/your-tenant/dags/

# ==== Data Iceberg Migrator DAG ====

# S3 Configuration
MIGRATION_DEFAULT_S3_BUCKET=s3a://your-bucket/path
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MIGRATION_TENANT_PROFILES={}

# SSH Configuration
CLUSTER_SSH_CONN_ID=cluster_edge_ssh
CLUSTER_EDGE_TEMP_PATH=/tmp/migration
CLUSTER_EDGE_DISCOVERY_TEMP_PATH=/tmp
CLUSTER_HIVE_SCRATCH_DIR=/tmp/hive

# DistCp Configuration
#
# DistCp queue budget: set all three or none. Every DistCp job gets an equal share
# (total_mappers // concurrent_jobs mappers, and the matching bandwidth share), and
# no more than concurrent_jobs run at once across all runs of this copy. Create the
# copy's pool FIRST: airflow pools set migration_distcp_<suffix> <concurrent_jobs> "..."
# (deploy.py prints it) - Airflow never runs a task whose pool doesn't exist.
# MIGRATION_DISTCP_TOTAL_MAPPERS=
# MIGRATION_DISTCP_TOTAL_BANDWIDTH_MBPS=
# MIGRATION_DISTCP_CONCURRENT_JOBS=

# Without a budget: a fixed pair for every job (set both or neither) ...
# MIGRATION_DISTCP_MAPPERS=
# MIGRATION_DISTCP_BANDWIDTH=
# ... otherwise these defaults
# MIGRATION_DISTCP_DEFAULT_MAPPERS=50
# MIGRATION_DISTCP_DEFAULT_BANDWIDTH=100

# DistCp copy strategy passed to -strategy
# MIGRATION_DISTCP_STRATEGY=dynamic

# JVM / MapReduce knobs. Empty (the default) emits nothing at all.
# MIGRATION_DISTCP_MAP_MEMORY_MB=
# MIGRATION_DISTCP_MAP_JAVA_OPTS=
# Exported as HADOOP_CLIENT_OPTS for the distcp client JVM
# MIGRATION_DISTCP_CLIENT_JAVA_OPTS=
# Appended verbatim to the distcp command; must already be -D-formatted.
# Inserted into the generated shell script unescaped — trusted input only.
# MIGRATION_DISTCP_EXTRA_HADOOP_OPTS=

# true = slower per-partition copy when partition_filter is used, but preserves delete semantics
# false = faster path-list copy for filtered partitions, additive only (no delete)
MIGRATION_DISTCP_PRESERVE_DELETE=true

# --- DistCp batch planning (WF-419) ---
# DistCp batch planning. Copy-cost weights are fixed in code, not configured —
# the batch cap derives from the DAG's execution_timeout.
# Hard cap on tables per batch.
# MIGRATION_DISTCP_MAX_TABLES_PER_BATCH=25
# Ceiling on one copy's timeout, seconds. Raise for multi-TB tables — but do
# not exceed 28200 without raising SSH_COMMAND_TIMEOUT alongside it: past that
# the SSH read window stops outlasting three in-shell attempts, and an
# abandoned copy leaves an orphaned YARN job writing to the same S3 prefix.
# MIGRATION_DISTCP_CALL_TIMEOUT_MAX_SECONDS=21600
# Concurrent DistCp batches per DAG run. Env-only: it is read at DAG parse time,
# so an Airflow Variable would cost a metadata-DB read on every parse loop.
# Total concurrent copies is this times max_active_runs (5).
# MIGRATION_DISTCP_COPY_MAX_CONCURRENT=3
# Concurrent destination-validation tasks per DAG run. Env-only, same reason.
# MIGRATION_VALIDATION_MAX_CONCURRENT=3
# Concurrent table discoveries per DAG run, each a pyspark driver on the edge node.
# Env-only, same reason. Size it to the edge node's memory.
# MIGRATION_DISCOVERY_MAX_CONCURRENT=3

# Path structure: true (default) = dest path is {bucket}/{database}/{table}
#                 false           = dest path is {bucket}/{table}  (database folder omitted)
MIGRATION_INCLUDE_DB_IN_PATH=true

# Spark Configuration
MIGRATION_SPARK_CONN_ID=spark_default

# Cluster Authentication (MapR or Kerberos)
AUTH_METHOD=mapr
# Cluster type: report label and S3A committer choice ('MapR', 'HDP' or 'CDP')
CLUSTER_TYPE=MapR
SERVICE_ACCOUNT_USER_ID=
MAPR_TICKETFILE_LOCATION=/tmp/maprticket_${USER}
# HDFS nameservice for HA clusters (e.g. mycluster); leave empty for MapR
HDFS_NAMESERVICE=

# Listing tool
S3_LISTING_TOOL=hadoop

# Email / SMTP Configuration
MIGRATION_SMTP_CONN_ID=smtp_default

# ==== Ranger Policies Generator DAG ====

# Ranger Configuration
RANGER_URL=http://ranger:6080
RANGER_USERNAME=
RANGER_PASSWORD=
NX1_REPO_NAME=nx1-unifiedsql

# Keycloak Configuration
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_VERIFY_SSL=false
KEYCLOAK_CACERT=

# Spark Configuration
SPARK_CONN_ID=spark_default

# Email / SMTP Configuration
POLICY_SMTP_CONN_ID=smtp_default

# Shared environment configuration
# Copy to env.shared and fill in actual values.
# It provides configuration for both Data Iceberg Migrator DAG and Ranger Policies Generator DAG.
# Only one copy should be present in the DAG folder.

# ==== deploy.py — S3 deployment target ====
DEPLOY_S3_BUCKET=your-bucket-name
DEPLOY_DAGS_PREFIX=airflow/your-tenant/dags/

# ==== Data Iceberg Migrator DAG ====

# S3 Configuration
MIGRATION_DEFAULT_S3_BUCKET=s3a://your-bucket/path
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MIGRATION_TENANT_PROFILES={}

# SSH Configuration
CLUSTER_SSH_CONN_ID=cluster_edge_ssh
CLUSTER_EDGE_TEMP_PATH=/tmp/migration
CLUSTER_EDGE_DISCOVERY_TEMP_PATH=/tmp
CLUSTER_HIVE_SCRATCH_DIR=/tmp/hive

# DistCp Configuration
# Mappers and per-mapper bandwidth (MB/s). Leave both unset (the default) to
# auto-size each table from its discovered size. Setting one without the other
# is an error — set both to force fixed values for every table.
# MIGRATION_DISTCP_MAPPERS=
# MIGRATION_DISTCP_BANDWIDTH=

# Auto-sizing inputs (used only when the two above are unset)
# Bytes of source data per mapper before another mapper is added (2 GiB)
# MIGRATION_DISTCP_TARGET_BYTES_PER_MAPPER=2147483648
# Floor and ceiling on the derived mapper count
# MIGRATION_DISTCP_MIN_MAPPERS=1
# MIGRATION_DISTCP_MAX_MAPPERS=100
# Total MB/s to spread across the mappers; per-mapper bandwidth is this / mappers
# MIGRATION_DISTCP_TARGET_AGGREGATE_MBPS=2000
# Used when the source size probe returns nothing usable
# MIGRATION_DISTCP_DEFAULT_MAPPERS=50
# MIGRATION_DISTCP_DEFAULT_BANDWIDTH=100

# DistCp copy strategy passed to -strategy
# MIGRATION_DISTCP_STRATEGY=dynamic

# JVM / MapReduce knobs. Empty (the default) emits nothing at all.
# MIGRATION_DISTCP_MAP_MEMORY_MB=
# MIGRATION_DISTCP_MAP_JAVA_OPTS=
# Exported as HADOOP_CLIENT_OPTS for the distcp client JVM
# MIGRATION_DISTCP_CLIENT_JAVA_OPTS=
# Appended verbatim to the distcp command; must already be -D-formatted.
# Inserted into the generated shell script unescaped — trusted input only.
# MIGRATION_DISTCP_EXTRA_HADOOP_OPTS=

# true = slower per-partition copy when partition_filter is used, but preserves delete semantics
# false = faster path-list copy for filtered partitions, additive only (no delete)
MIGRATION_DISTCP_PRESERVE_DELETE=true

# Path structure: true (default) = dest path is {bucket}/{database}/{table}
#                 false           = dest path is {bucket}/{table}  (database folder omitted)
MIGRATION_INCLUDE_DB_IN_PATH=true

# Spark Configuration
MIGRATION_SPARK_CONN_ID=spark_default

# Cluster Authentication (MapR or Kerberos)
AUTH_METHOD=mapr
# Cluster type for display/reporting ('MapR' or 'HDP')
CLUSTER_TYPE=MapR
SERVICE_ACCOUNT_USER_ID=
MAPR_TICKETFILE_LOCATION=/tmp/maprticket_${USER}
# HDFS nameservice for HA clusters (e.g. mycluster); leave empty for MapR
HDFS_NAMESERVICE=

# Listing tool
S3_LISTING_TOOL=hadoop

# Email / SMTP Configuration
MIGRATION_SMTP_CONN_ID=smtp_default

# ==== Ranger Policies Generator DAG ====

# Ranger Configuration
RANGER_URL=http://ranger:6080
RANGER_USERNAME=
RANGER_PASSWORD=
NX1_REPO_NAME=nx1-unifiedsql

# Keycloak Configuration
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_VERIFY_SSL=false
KEYCLOAK_CACERT=

# Spark Configuration
SPARK_CONN_ID=spark_default

# Email / SMTP Configuration
POLICY_SMTP_CONN_ID=smtp_default
